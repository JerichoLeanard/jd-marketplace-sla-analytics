# Ignore large CSVs and SQLite database binaries across all data layers
data/raw/*.csv
data/interim/*.csv
data/processed/*.csv
data/powerbi/*.csv
*.db
*.sqlite
*.sqlite3

# Keep folder structure tracked in Git
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/powerbi/.gitkeep

# Python virtual environment & cache
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/